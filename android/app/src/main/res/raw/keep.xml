<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps the media notification's icons.

  audio_service looks its control icons up by name at run time, so the
  resource shrinker cannot see that they are used and strips them from the
  release build. The plugin then throws "You must specify an icon resource id
  to build a CustomAction" on every state update, the platform session is
  never told anything, and there is no notification and no error anywhere a
  person would look.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_*"
    tools:shrinkMode="safe" />
